# Base URL of the anymaps widget server. The client uses it for the gallery,
# widget install, and provisioning requests.
#
# Runtime overrides still win over this value, in order:
#   1. window.__ANYMAPS_CONFIG__.baseUrl
#   2. localStorage["anymaps.baseUrl"]
#
# Copy this file to .env (or .env.local) and adjust. Both are gitignored.
VITE_SERVER_URL=http://localhost:8000
