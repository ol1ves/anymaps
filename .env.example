# Copy to .env and fill in. .env is gitignored.
WIZARD_LLM_API_KEY=

# Serper.dev search key (https://serper.dev) for the wizard's documentation
# lookup, so it can verify third-party API endpoints before generating.
SERPER_API_KEY=

# Reverse-proxy path prefix for the server and agent (e.g. Nginx Proxy
# Manager locations /server and /agent). Leave empty for local/no-proxy runs.
SERVER_PATH_PREFIX=
AGENT_PATH_PREFIX=
